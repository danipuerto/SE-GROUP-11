<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.grocery.ui.GroceryController"
            prefWidth="1100"
            prefHeight="720"
            style="-fx-background-color: #fbf3e7; -fx-base: #ececec; -fx-text-fill: #2b2b2b;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18"
              style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #f0d9c0 transparent;">

            <padding>
                <Insets top="18"
                        right="25"
                        bottom="18"
                        left="25"/>
            </padding>

            <VBox spacing="2">
                <Label text="Best Groceries in Town"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #c1571c;"/>

                <Label text="Online Grocery Store"
                       style="-fx-text-fill: #8a7259;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField
                    fx:id="searchField"
                    promptText="Search groceries..."
                    prefWidth="260"
                    style="-fx-background-radius: 8;
                           -fx-padding: 10;"/>

            <Button
                    text="Refresh"
                    onAction="#refreshProducts"
                    style="-fx-background-color: #fbe4cf;
                           -fx-text-fill: #c1571c;
                           -fx-font-weight: bold;
                           -fx-padding: 10 16;
                           -fx-background-radius: 8;"/>

            <Button
                    fx:id="adminButton"
                    text="Admin Panel"
                    onAction="#openAdminPanel"
                    managed="false"
                    visible="false"
                    style="-fx-background-color: #2f7a3a;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 10 16;
                           -fx-background-radius: 8;"/>

            <Button
                    fx:id="viewCartButton"
                    text="View Cart"
                    onAction="#openCart"
                    style="-fx-background-color: #d9662b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 10 18;
                           -fx-background-radius: 8;"/>

            <Button
                    text="Logout"
                    onAction="#logout"
                    style="-fx-background-color: #fbe4cf;
                           -fx-text-fill: #c1571c;
                           -fx-font-weight: bold;
                           -fx-padding: 10 16;
                           -fx-background-radius: 8;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <VBox spacing="8"
                  style="-fx-background-color: #d9662b;
                         -fx-background-radius: 18;
                         -fx-padding: 35;">

                <Label
                        text="Fresh groceries, down at the corner."
                        style="-fx-font-size: 34px;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>

                <Label
                        text="Browse products, add items to your cart, and check out."
                        style="-fx-font-size: 16px;
                               -fx-text-fill: white;"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label
                        text="Available Products"
                        style="-fx-font-size: 27px;
                               -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Category:" style="-fx-text-fill: #8a7259;"/>

                <ComboBox
                        fx:id="categoryFilter"
                        onAction="#filterProducts"
                        prefWidth="160"/>
            </HBox>

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">

                <content>
                    <TilePane
                            fx:id="productContainer"
                            prefColumns="3"
                            hgap="20"
                            vgap="20"
                            style="-fx-padding: 5;"/>
                </content>

            </ScrollPane>

            <Label
                    fx:id="statusLabel"
                    text="Loading..."
                    style="-fx-text-fill: #8a7259;"/>

        </VBox>
    </center>

</BorderPane>